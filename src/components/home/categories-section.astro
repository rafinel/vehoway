---
import { HugeiconsIcon } from '@hugeicons/react';
import { ArrowRight01Icon } from '@hugeicons/core-free-icons';
import bauFrigorifico from '@/assets/images/bau-frigorifico.png';
import caminhoes from '@/assets/images/caminhoes.png';
import carroceria from '@/assets/images/carroceria.png';
import implementos from '@/assets/images/implementos.png';
import pneumatica from '@/assets/images/pneumatica.png';
import { sanityCategoriesCollection } from '@/cms/sanity/collections';
import { HOME_PAGE_LIMITS } from '@/constants/home-page-limits';
import { ROUTES } from '@/constants/routes';

export type HomeCategoryCard = {
  id: string;
  imageAlt: string;
  imageUrl: string;
  name: string;
};

const fallbackCategories: HomeCategoryCard[] = [
  {
    id: 'carroceria',
    imageAlt: 'Linha de pecas para carroceria de bebidas',
    imageUrl: carroceria.src,
    name: 'Pecas Carroceria de Bebidas',
  },
  {
    id: 'bau-frigorifico',
    imageAlt: 'Linha de pecas para bau frigorifico',
    imageUrl: bauFrigorifico.src,
    name: 'Pecas Inox Bau Frigorifico',
  },
  {
    id: 'caminhoes',
    imageAlt: 'Linha de pecas e acessorios para caminhoes',
    imageUrl: caminhoes.src,
    name: 'Pecas e Acessorios Caminhoes',
  },
  {
    id: 'implementos',
    imageAlt: 'Linha de pecas para implementos rodoviarios',
    imageUrl: implementos.src,
    name: 'Pecas Implementos Rodoviarios',
  },
  {
    id: 'pneumatica',
    imageAlt: 'Linha de automacao industrial e pneumatica',
    imageUrl: pneumatica.src,
    name: 'Automacao Industrial Pneumatica',
  },
];

const categoriesResult = await sanityCategoriesCollection
  .getCategories()
  .catch(() => []);

const categories =
  categoriesResult.length > 0
    ? categoriesResult.slice(0, HOME_PAGE_LIMITS.categories).map(category => ({
        id: category.id,
        imageAlt: category.image.alt,
        imageUrl: category.image.url,
        name: category.name,
      }))
    : fallbackCategories;
---

<section class='vh-shell px-5 py-12 md:px-8 md:py-16' id='categorias'>
  <div class='mb-8 flex items-end justify-between gap-4'>
    <div>
      <p
        class='mb-3 text-sm font-bold uppercase tracking-[0.24em] text-vh-brown'
      >
        Categorias publicadas
      </p>
      <h2 class='vh-section-title'>Nossas categorias de produtos</h2>
      <p class='mt-3 text-base text-vh-muted'>
        Solucoes completas para cada necessidade do transporte.
      </p>
    </div>
    <a
      class='hidden items-center gap-2 text-sm font-bold text-vh-brown md:inline-flex'
      href={ROUTES.products}
    >
      Ver todas as categorias
      <HugeiconsIcon
        icon={ArrowRight01Icon}
        className='h-4 w-4'
        strokeWidth={2.2}
      />
    </a>
  </div>

  <div class='grid gap-5 md:grid-cols-2 xl:grid-cols-5'>
    {
      categories.map(category => (
        <article class='overflow-hidden rounded-[10px] border border-[#e6d39a] bg-white shadow-[0_10px_30px_rgba(15,23,42,0.08)] transition hover:-translate-y-0.5 hover:shadow-[0_16px_34px_rgba(15,23,42,0.12)]'>
          <img
            alt={category.imageAlt}
            class='h-52 w-full object-cover'
            loading='lazy'
            src={category.imageUrl}
          />
          <div class='flex min-h-[134px] flex-col justify-between gap-4 p-5'>
            <h3 class='font-[var(--font-display)] text-[1rem] font-extrabold tracking-[-0.03em] text-vh-copy'>
              {category.name}
            </h3>
            <a
              class='inline-flex items-center gap-2 text-sm font-bold text-vh-brown transition hover:text-vh-copy'
              href={`${ROUTES.products}?category=${encodeURIComponent(category.id)}`}
            >
              ver produtos
              <HugeiconsIcon
                icon={ArrowRight01Icon}
                className='h-4 w-4'
                strokeWidth={2.2}
              />
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
